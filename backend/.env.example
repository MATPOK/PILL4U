# Skopiuj ten plik do `.env` i uzupełnij wartościami.
# Plik `.env` NIE może trafić do repozytorium (jest w .gitignore).

PORT=3000

# Wygeneruj silny, losowy sekret, np.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Nie używaj słownikowych haseł typu "kluczdopill4u".
JWT_SECRET=your_strong_random_secret_here
